{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "src/endurance/**/*.ts",
    "src/endurance/**/*.json",
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/utils/sectorStatus.ts",
    "src/utils/sessionFlags.ts",
    "src/utils/trackFlags.ts",
    "src/utils/trackGap.ts",
    "src/utils/nationality.ts",
    "src/utils/driverFlair.ts",
    "src/data/iracing-flairs.json",
    "electron/data/seriesCatalog.json"
  ]
}
